prefix=C:/ffmpeg
exec_prefix=${prefix}
libdir=C:/ffmpeg/lib
includedir=C:/ffmpeg/include

Name: libavformat
Description: FFmpeg container format library
Version: 62.13.101
Requires: 
Requires.private: libavcodec >= 62.29.101, libswresample >= 6.4.100, libavutil >= 60.29.100
Conflicts:
Libs: -L${libdir}  -lavformat 
Libs.private: -lm -latomic -lz -lsecur32 -lncrypt -lcrypt32 -lws2_32
Cflags: -I${includedir}
